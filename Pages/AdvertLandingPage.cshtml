@page
@model AdvertLandingPageModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Advertisements";
}

<h1 class="welcome-text">Explore Our Programs and Offerings</h1>

<div class="advert-container">
    <!-- Program 1 -->
    <div class="advert-grid">
        @foreach (var advert in Model.Advertisements.Where(a => a.Location == 1 && a.IsActive))
        {
            <div class="advert-card">
                <div class="advert-image">
                    <img src="@advert.ImagePath" alt="@advert.Title" />
                </div>
                <div class="advert-details">
                    <h3>@advert.Title</h3>
                    <p>@advert.Description</p>
                    <a href="@advert.Link" class="btn btn-primary" target="_blank">Learn More</a>
                </div>
            </div>
        }
    </div>

    <!-- Program 2 -->
    <div class="advert-grid">
        @foreach (var advert in Model.Advertisements.Where(a => a.Location == 2 && a.IsActive))
        {
            <div class="advert-card">
                <div class="advert-image">
                    <img src="@advert.ImagePath" alt="@advert.Title" />
                </div>
                <div class="advert-details">
                    <h3>@advert.Title</h3>
                    <p>@advert.Description</p>
                    <a href="@advert.Link" class="btn btn-primary" target="_blank">Learn More</a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    :root {
    --maroon: #642032;
    --maroon-light: #7A2A3F;
    --white: #FFFFFF;
    --gray-light: #F5F5F5;
    --gray: #E0E0E0;
}

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    body {
        background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-light) 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }

    .advert-container {
        width: 100%;
        max-width: 1200px; /* Adjust as needed for responsiveness */
        margin: 2rem auto;
        padding: 0 20px;
    }

    .welcome-text {
        color: var(--white); /* Match the Index page */
        text-align: center;
        font-size: 32px; /* Slightly larger for emphasis */
        margin-bottom: 30px;
        font-weight: 700;
    }

    .advert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px; /* Add space between the two grids */
    }

    .advert-card {
        background: var(--gray-light);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease-in-out;
    }

    .advert-card:hover {
        transform: scale(1.05);
    }

    .advert-image {
        width: 100%;
        height: 200px; /* Fixed height for consistent layout */
        background-color: var(--gray); /* Placeholder background */
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .advert-image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: cover; /* Ensures images fit within the placeholder */
    }

    .advert-heading {
        font-size: 18px;
        color: var(--maroon);
        margin: 10px 0;
        font-weight: 600;
    }

    .advert-description {
        font-size: 14px;
        color: #333;
    }

    .advert-details .btn {
        text-decoration: none;
        color: #fff;
        background-color: var(--maroon);
        padding: 10px 20px;
        border-radius: 5px;
        transition: background-color 0.2s ease-in-out;
    }

    .advert-details .btn:hover {
        background-color: var(--maroon-light);
    }
</style>