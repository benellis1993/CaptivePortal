@page
@model NabooFinalProject.Pages.TermsOfServiceModel
@{
    ViewData["Title"] = "Terms of Service";
    var termsLines = Model.TermsContent.Split('\n'); // Split content into lines
}

<div class="login-container">
    <div class="login-box">
        <div class="logo-container">
            <img src="/images/WT-logo.jpg" alt="WT Logo" class="logo">
        </div>
        <h1 class="welcome-text">Terms of Service</h1>
        <div class="login-card">
            <div class="card-body">
                <div class="terms-container">
                    <p>@termsLines[0]</p> <!-- Display the introductory line -->
                    <ol>
                        @for (int i = 1; i < termsLines.Length - 1; i++) // Render all but the last line as list items
                        {
                            <li>@termsLines[i]</li>
                        }
                    </ol>
                    <p>@termsLines[^1]</p> <!-- Display the last line as a separate paragraph -->
                </div>
                <form method="get" action="/Index">
                    <button type="submit" class="login-button">Continue</button>
                </form>
            </div>
        </div>
        <div class="footer-text">
            <p>West Texas A&M University</p>
            <p class="support-text">For technical support, please contact IT Services</p>
        </div>
    </div>
</div>

<style>
    :root {
        --maroon: #642032;
        --maroon-light: #7A2A3F;
        --white: #FFFFFF;
        --gray-light: #F5F5F5;
        --gray: #E0E0E0;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    body {
        background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-light) 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        margin: 2rem auto;
        padding: 0 20px;
    }

    .login-box {
        background: var(--white);
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        width: 100%;
    }

    .logo-container {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo {
        max-height: 120px;
        width: auto;
    }

    .welcome-text {
        color: var(--maroon);
        text-align: center;
        font-size: 24px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .login-card {
        background: var(--gray-light);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-body {
        padding: 30px;
    }

    .terms-container {
        margin: 20px 0;
        padding: 20px;
        border: 1px solid var(--gray);
        background-color: var(--white);
        border-radius: 8px;
        font-size: 14px;
        line-height: 1.6;
        color: #333;
    }

    .login-button {
        width: 100%;
        padding: 15px;
        background: var(--maroon);
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .login-button:hover {
        background: var(--maroon-light);
    }

    .footer-text {
        text-align: center;
        margin-top: 30px;
        color: var(--maroon);
        font-size: 14px;
    }

    .support-text {
        margin-top: 5px;
        opacity: 0.8;
    }
</style>