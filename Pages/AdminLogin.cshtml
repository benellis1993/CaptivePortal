@page
@model naboo_final_project.Pages.AdminLoginModel

@{
    ViewData["Title"] = "Admin Login";
}
<link rel="stylesheet" href="~/css/styles.css" />
<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-box">
        <div class="logo-container">
            <img src="@Model.ImagePath" alt="WT Logo" class="logo">
        </div>
        <h1 class="welcome-text">Admin Portal</h1>
        <div class="login-card">
            <div class="card-header">
                <h2>Admin Login</h2>
                <p>Enter your credentials to access the admin portal</p>
            </div>
            <div class="card-body">
                <form class="login-form" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label for="Email">Email Address</label>
                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               placeholder="Enter your email address"
                               title="Please enter a valid email address"
                               required />
                    </div>
                    <div class="form-group">
                        <label for="Password">Password</label>
                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               title="Please enter your password"
                               required />
                    </div>
                    <button type="submit" class="login-button">Login</button>
                </form>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="text-danger">@Model.ErrorMessage</p>
                }
            </div>
        </div>
        <div class="footer-text">
            <p>West Texas A&M University</p>
        </div>
    </div>
</div>

