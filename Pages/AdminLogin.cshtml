@page
@model naboo_final_project.Pages.AdminLoginModel

@{
    ViewData["Title"] = "Admin Login";
}
<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-box">
        <div class="logo-container">
            <img src="@Model.ImagePath" alt="WT Logo" class="logo">
        </div>
        <h1 class="welcome-text">Admin Portal</h1>
        <div class="login-card">
            <div class="card-header">
                <h2>Admin Login</h2>
                <p>Enter your credentials to access the admin portal</p>
            </div>
            <div class="card-body">
                <form class="login-form" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label for="Email">Email Address</label>
                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               placeholder="Enter your email address"
                               title="Please enter a valid email address"
                               required />
                    </div>
                    <div class="form-group">
                        <label for="Password">Password</label>
                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               title="Please enter your password"
                               required />
                    </div>
                    <button type="submit" class="login-button">Login</button>
                </form>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="text-danger">@Model.ErrorMessage</p>
                }
            </div>
        </div>
        <div class="footer-text">
            <p>West Texas A&M University</p>
        </div>
    </div>
</div>

<style>
    :root {
        --maroon: #642032;
        --maroon-light: #7A2A3F;
        --white: #FFFFFF;
        --gray-light: #F5F5F5;
        --gray: #E0E0E0;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    body {
        background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-light) 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        margin: 2rem auto;
        padding: 0 20px;
    }

    .login-box {
        background: var(--white);
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        width: 100%;
    }

    .logo-container {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo {
        max-height: 120px;
        width: auto;
    }

    .welcome-text {
        color: var(--maroon);
        text-align: center;
        font-size: 24px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .login-card {
        background: var(--gray-light);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header {
        background: var(--maroon);
        color: var(--white);
        padding: 20px;
        text-align: center;
    }

    .card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
    }

    .card-header p {
        margin: 5px 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .card-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid var(--gray);
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--maroon);
    }

    .login-button {
        width: 100%;
        padding: 15px;
        background: var(--maroon);
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .login-button:hover {
        background: var(--maroon-light);
    }

    .footer-text {
        text-align: center;
        margin-top: 30px;
        color: var(--maroon);
        font-size: 14px;
    }

    .support-text {
        margin-top: 5px;
        opacity: 0.8;
    }

    .form-text {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #666;
    }

    .form-control:invalid {
        border-color: var(--maroon);
    }

    .form-control:valid {
        border-color: #28a745;
    }

    @@media (max-width: 480px) {
        .login-box {
            padding: 20px;
        }
        
        .card-body {
            padding: 20px;
        }
    }

    .login-button:disabled {
    background-color: #cccccc; /* Light gray */
    cursor: not-allowed;       /* Shows a forbidden cursor */
    color: #666666;            /* Slightly dim text */
}
</style>