@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome to WT Network";
}

<div class="login-container">
    <div class="login-box">
        <div class="logo-container">
            <img src="/images/WT-logo.jpg" alt="WT Logo" class="logo">
        </div>
        <h1 class="welcome-text">@Model.WelcomeText</h1>
        <div class="login-card">
            <div class="card-header">
                <h2>Network Access</h2>
                <p>Please enter your email to connect</p>
            </div>
            <div class="card-body">
                <form class="login-form" method="post">
                    <div class="form-group">
                        <input type="email" 
                               class="form-control" 
                               placeholder="Enter your email address" 
                               title="Please enter a valid email address"
                               required>
                        <small class="form-text">Enter your email address to connect</small>
                    </div>
                    <div class="form-group">
                        <input type="password" 
                               class="form-control" 
                               placeholder="Password" 
                               required>
                    </div>
                    <div class="form-group terms-checkbox">
                        <label class="checkbox-container">
                            <input type="checkbox" id="termsCheckbox" required>
                            <span class="checkmark"></span>
                            <span class="checkbox-text">I accept the Terms of Service</span>
                        </label>
                        <small class="form-text">
                            <a href="@Model.TermsLink" class="terms-link" target="_blank">Read our Terms of Service</a>
                        </small>
                    </div>
                    <button id="connectButton" type="submit" class="login-button" disabled title="Accept Terms of Service to continue.">Connect to Network</button>
                </form>
            </div>
        </div>
        <div class="footer-text">
            <p>West Texas A&M University</p>
            <p class="support-text">For technical support, please contact IT Services</p>
        </div>
    </div>
</div>

<style>
    :root {
        --maroon: #642032;
        --maroon-light: #7A2A3F;
        --white: #FFFFFF;
        --gray-light: #F5F5F5;
        --gray: #E0E0E0;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    body {
        background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-light) 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        margin: 2rem auto;
        padding: 0 20px;
    }

    .login-box {
        background: var(--white);
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        width: 100%;
    }

    .logo-container {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo {
        max-height: 120px;
        width: auto;
    }

    .welcome-text {
        color: var(--maroon);
        text-align: center;
        font-size: 24px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .login-card {
        background: var(--gray-light);
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header {
        background: var(--maroon);
        color: var(--white);
        padding: 20px;
        text-align: center;
    }

    .card-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
    }

    .card-header p {
        margin: 5px 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .card-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid var(--gray);
        border-radius: 8px;
        font-size: 16px;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--maroon);
    }

    .login-button {
        width: 100%;
        padding: 15px;
        background: var(--maroon);
        color: var(--white);
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .login-button:hover {
        background: var(--maroon-light);
    }

    .footer-text {
        text-align: center;
        margin-top: 30px;
        color: var(--maroon);
        font-size: 14px;
    }

    .support-text {
        margin-top: 5px;
        opacity: 0.8;
    }

    .form-text {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #666;
    }

    .terms-text {
        margin-top: 20px;
        text-align: center;
        font-size: 12px;
        color: #666;
    }

    .form-control:invalid {
        border-color: var(--maroon);
    }

    .form-control:valid {
        border-color: #28a745;
    }

    @@media (max-width: 480px) {
        .login-box {
            padding: 20px;
        }
        
        .card-body {
            padding: 20px;
        }
    }

    .terms-checkbox {
        margin: 20px 0;
    }

    .checkbox-container {
        display: flex;
        align-items: center;
        position: relative;
        padding-left: 35px;
        cursor: pointer;
        font-size: 14px;
        user-select: none;
    }

    .checkbox-container input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
        height: 0;
        width: 0;
    }

    .checkmark {
        position: absolute;
        left: 0;
        height: 20px;
        width: 20px;
        background-color: var(--white);
        border: 2px solid var(--gray);
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .checkbox-container:hover input ~ .checkmark {
        border-color: var(--maroon);
    }

    .checkbox-container input:checked ~ .checkmark {
        background-color: var(--maroon);
        border-color: var(--maroon);
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 6px;
        top: 2px;
        width: 4px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .checkbox-container input:checked ~ .checkmark:after {
        display: block;
    }

    .checkbox-text {
        color: #333;
    }

    .terms-link {
        color: var(--maroon);
        text-decoration: none;
        font-weight: 500;
    }

    .terms-link:hover {
        text-decoration: underline;
    }

    .login-button:disabled {
    background-color: #cccccc; /* Light gray */
    cursor: not-allowed;       /* Shows a forbidden cursor */
    color: #666666;            /* Slightly dim text */
}
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var checkbox = document.getElementById('termsCheckbox');
        var button = document.getElementById('connectButton');

        checkbox.addEventListener('change', function() {
            button.disabled = !checkbox.checked;
            if (checkbox.checked) {
                button.removeAttribute('title');
            } else {
                button.setAttribute('title', 'Accept Terms of Service to continue.');
            }
        });
    });
</script>