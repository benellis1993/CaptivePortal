@page
@model naboo_final_project.Pages.IndexModel

@{
    ViewData["Title"] = "Welcome to WT Network";
}
<link rel="stylesheet" href="~/css/login.css" /> 
<link rel="stylesheet" href="~/css/styles.css" />

<div class="login-container">
    <div class="login-box">
        <div class="logo-container">
            <img src="@Model.ImagePath" alt="WT Logo" class="logo">
        </div>
        <h1 class="welcome-text">@Model.WelcomeText</h1>
        <div class="login-card">
            <div class="card-header">
                <h2>Network Access</h2>
                <p>Please enter your email to connect</p>
            </div>
            <div class="card-body">
                <form class="login-form" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="UserEmail">Email Address</label>
                        <input type="email"
                                 id="UserEmail"
                               class="form-control"
                               placeholder="Enter your email address"
                               title="Please enter a valid email address"
                               required {# HTML5 required attribute for basic client-side check #}
                               asp-for="UserEmail">

                        <small class="form-text">Enter your email address to connect</small>
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                        <span id=" email-error" class="text-danger"></span>
                    </div>
                    <div class="form-group terms-checkbox">
                        <label class="checkbox-container">
                            <input type="checkbox" id="termsCheckbox" required>
                            <span class="checkmark"></span>
                            <span class="checkbox-text">I accept the Terms of Service</span>
                        </label>
                        <small class="form-text">
                            <a href="@Model.TermsLink" class="terms-link" target="_blank">Read our Terms of Service</a>
                        </small>
                    </div>
                    <button id="connectButton" type="submit" class="login-button" disabled title="Accept Terms of Service to continue.">Connect to Network</button>
                </form>
            </div>
        </div>
        <div class="footer-text">
            <p>West Texas A&M University</p>
            <p class="support-text">For technical support, please contact IT Services</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/validation.js"></script>}
</script>