@page
@model naboo_final_project.Pages.RegistrationConfirmationModel
@{
    ViewData["Title"] = "Registration Confirmation";
}

<h1>Registration Confirmation</h1>

<p>
    Thank you for registering! A confirmation email has been sent to <strong>@Model.Email</strong>.
    Please check your inbox (and spam folder) and click the link in the email to confirm your address.
</p>

<p>If you don't receive the email within a few minutes, you may need to check your spam folder or try registering again.</p>
<p><a href="/">Return to Home</a></p>
